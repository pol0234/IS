              a: "<span class='hl-blue'>Analýza požiadaviek</span> &rarr; <span class='hl-purple'>Návrh riešenia</span> &rarr; <span class='hl-orange'>Implementácia/Programovanie</span> &rarr; <span class='hl-red'>Testovanie</span> &rarr; <span class='hl-green'>Nasadenie</span> &rarr; Prevádzka a údržba." },
            { id: 22, cat: "Vývoj IS a Agilita", icon: "fa-magnifying-glass", color: "#22c55e", 
