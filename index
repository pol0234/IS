<!DOCTYPE html>
<html lang="sk" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projektové Riadenie - Smart IS</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        poppins: ['Poppins', 'sans-serif'],
                    },
                    colors: {
                        dark: '#0f172a',
                        card: '#1e293b',
                    }
                }
            }
        }
    </script>

    <style>
        /* Dynamické témy pozadia */
        body { transition: background 0.4s ease, color 0.4s ease; min-height: 100vh; display: flex; flex-direction: column; }
        
        .theme-dark {
            background-color: #0f172a;
            color: #f8fafc;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(59, 130, 246, 0.15), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.15), transparent 25%);
            background-attachment: fixed;
            font-family: 'Inter', sans-serif;
        }

        .theme-light {
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
            color: #1f2937;
            font-family: 'Poppins', sans-serif;
        }

        /* --- ŠTÝLY PRE METODIKY --- */
        .glass { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.4); border-color: rgba(59, 130, 246, 0.5); }
        
        .modal-enter { animation: modalFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        
        .filter-btn.active { background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; border-color: transparent; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3); }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); }
        ::-webkit-scrollbar-thumb { background: #64748b; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }

        /* --- ŠTÝLY PRE OTÁZKY --- */
        .hl-blue { background-color: #dbeafe; color: #1e3a8a; font-weight: 700; padding: 2px 6px; border-radius: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .hl-red { background-color: #fee2e2; color: #991b1b; font-weight: 700; padding: 2px 6px; border-radius: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .hl-green { background-color: #dcfce7; color: #166534; font-weight: 700; padding: 2px 6px; border-radius: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .hl-purple { background-color: #f3e8ff; color: #6b21a8; font-weight: 700; padding: 2px 6px; border-radius: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .hl-orange { background-color: #ffedd5; color: #9a3412; font-weight: 700; padding: 2px 6px; border-radius: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }

        .flashcard-container { perspective: 1000px; cursor: pointer; min-height: 280px; }
        .flashcard { position: relative; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1); transform-style: preserve-3d; }
        .flashcard.flipped { transform: rotateY(180deg); }
        .flashcard-front, .flashcard-back { position: absolute; width: 100%; height: 100%; -webkit-backface-visibility: hidden; backface-visibility: hidden; border-radius: 1rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); display: flex; flex-direction: column; padding: 1.5rem; background-color: white; border-top: 6px solid #3b82f6; }
        .flashcard-back { transform: rotateY(180deg); border-top-color: #10b981; overflow-y: auto; }
        .watermark { position: absolute; bottom: -20px; right: -20px; font-size: 8rem; color: rgba(0,0,0,0.03); z-index: 0; pointer-events: none; }
        .content-z { position: relative; z-index: 10; }
        .btn-filter-q.active { background-color: #3b82f6; color: white; border-color: #3b82f6; }

        /* Navbar switch UI */
        .nav-switch-btn { transition: all 0.3s ease; }
        .nav-switch-btn.active { background-color: #3b82f6; color: white; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); }
    </style>
</head>
<body class="antialiased theme-dark" id="main-body">

    <nav class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-lg border-b border-slate-700/50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2 text-blue-400 font-bold text-xl">
                <i class="fa-solid fa-layer-group"></i> Smart IS
            </div>
            
            <div class="bg-slate-800 p-1 rounded-xl flex gap-1 border border-slate-700">
                <button id="nav-metodiky" onclick="switchTab('metodiky')" class="nav-switch-btn active px-4 py-1.5 rounded-lg text-sm font-semibold text-slate-300 flex items-center gap-2">
                    <i class="fa-solid fa-book-open"></i> Encyklopédia
                </button>
                <button id="nav-otazky" onclick="switchTab('otazky')" class="nav-switch-btn px-4 py-1.5 rounded-lg text-sm font-semibold text-slate-300 flex items-center gap-2 hover:text-white">
                    <i class="fa-solid fa-brain"></i> Tréning
                </button>
            </div>
        </div>
    </nav>

    <div id="view-metodiky" class="flex-grow flex flex-col w-full">
        <header class="pt-12 pb-8 px-4 text-center">
            <div class="inline-block mb-4 px-4 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-400 text-sm font-semibold tracking-wider uppercase">
                Vzdelávacia platforma
            </div>
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400">
                Encyklopédia IT Projektov
            </h1>
            <p class="text-slate-400 max-w-2xl mx-auto text-lg">
                Objav a pochop kľúčové metodiky vývoja, frameworky a analytické nástroje.
            </p>
        </header>

        <div class="bg-transparent py-4 px-4 mb-4">
            <div class="max-w-6xl mx-auto flex flex-wrap justify-center gap-3" id="filters">
                <button data-filter="all" class="filter-btn active px-5 py-2 rounded-xl border border-slate-700 text-slate-300 font-medium hover:bg-slate-800">Všetko</button>
                <button data-filter="sdlc" class="filter-btn px-5 py-2 rounded-xl border border-slate-700 text-slate-300 font-medium hover:bg-slate-800"><i class="fa-solid fa-code mr-2 text-blue-400"></i> Metodiky vývoja</button>
                <button data-filter="pm" class="filter-btn px-5 py-2 rounded-xl border border-slate-700 text-slate-300 font-medium hover:bg-slate-800"><i class="fa-solid fa-briefcase mr-2 text-purple-400"></i> Projektové riadenie</button>
                <button data-filter="tools" class="filter-btn px-5 py-2 rounded-xl border border-slate-700 text-slate-300 font-medium hover:bg-slate-800"><i class="fa-solid fa-chart-network mr-2 text-emerald-400"></i> Nástroje a Modelovanie</button>
            </div>
        </div>

        <main class="flex-grow max-w-7xl mx-auto px-4 pb-20 w-full">
            <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>
        </main>
    </div>

    <div id="view-otazky" class="hidden flex-grow flex flex-col w-full">
        <header class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 py-6">
                <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                    <div class="flex items-center gap-3">
                        <div class="bg-blue-600 text-white p-3 rounded-lg shadow-md">
                            <i class="fa-solid fa-bolt text-2xl"></i>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Active Recall Tréning</h2>
                            <p class="text-sm text-gray-500 font-medium">Kliknutím na kartu zobrazíš odpoveď</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-4 w-full md:w-auto">
                        <button onclick="shuffleCards()" class="bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100 px-4 py-2 rounded-lg font-semibold transition-colors flex items-center gap-2 text-sm">
                            <i class="fa-solid fa-shuffle"></i> Zamiešať
                        </button>
                        <div class="w-full md:w-48 bg-gray-200 rounded-full h-4 shadow-inner relative overflow-hidden">
                            <div id="progress-bar" class="bg-gradient-to-r from-green-400 to-emerald-500 h-4 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                        <span id="progress-text" class="text-sm font-bold text-gray-600 whitespace-nowrap">0 / 40</span>
                    </div>
                </div>

                <div class="mt-6 flex flex-wrap gap-2 justify-center" id="filters-container-q">
                    <button onclick="filterCards('Všetky')" class="btn-filter-q active px-4 py-1.5 rounded-full border border-gray-300 text-sm font-medium transition-colors hover:bg-gray-100 text-gray-700">Všetky</button>
                    <button onclick="filterCards('Základy')" class="btn-filter-q px-4 py-1.5 rounded-full border border-gray-300 text-sm font-medium transition-colors hover:bg-gray-100 text-gray-700"><i class="fa-solid fa-book text-blue-500 mr-1"></i> Základy</button>
                    <button onclick="filterCards('Fázy a Životný cyklus')" class="btn-filter-q px-4 py-1.5 rounded-full border border-gray-300 text-sm font-medium transition-colors hover:bg-gray-100 text-gray-700"><i class="fa-solid fa-rotate text-orange-500 mr-1"></i> Životný cyklus</button>
                    <button onclick="filterCards('Metodiky a Štandardy')" class="btn-filter-q px-4 py-1.5 rounded-full border border-gray-300 text-sm font-medium transition-colors hover:bg-gray-100 text-gray-700"><i class="fa-solid fa-scale-balanced text-purple-500 mr-1"></i> Metodiky</button>
                    <button onclick="filterCards('Vývoj IS a Agilita')" class="btn-filter-q px-4 py-1.5 rounded-full border border-gray-300 text-sm font-medium transition-colors hover:bg-gray-100 text-gray-700"><i class="fa-solid fa-code-branch text-green-500 mr-1"></i> Agilita</button>
                    <button onclick="filterCards('Čas a Plánovanie')" class="btn-filter-q px-4 py-1.5 rounded-full border border-gray-300 text-sm font-medium transition-colors hover:bg-gray-100 text-gray-700"><i class="fa-regular fa-calendar-check text-red-500 mr-1"></i> Čas</button>
                    <button onclick="filterCards('Tím a Roly')" class="btn-filter-q px-4 py-1.5 rounded-full border border-gray-300 text-sm font-medium transition-colors hover:bg-gray-100 text-gray-700"><i class="fa-solid fa-users text-teal-500 mr-1"></i> Tím</button>
                </div>
            </div>
        </header>

        <main class="flex-grow max-w-7xl mx-auto px-4 py-8 w-full">
            <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>
        </main>
    </div>

    <footer class="py-6 text-center text-sm font-medium opacity-60 mt-auto">
        IS Vzdelávacia platforma
    </footer>

    <div id="modal-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
        <div id="modal" class="glass rounded-2xl w-full max-w-5xl max-h-[90vh] overflow-y-auto hidden transform scale-95 transition-all duration-300 border border-slate-600/50 shadow-2xl font-sans">
            <div class="relative p-6 md:p-8">
                <button id="close-modal" class="absolute top-4 right-4 w-10 h-10 bg-slate-800 hover:bg-red-500 hover:text-white rounded-full flex items-center justify-center transition-colors text-slate-300 z-10 border border-slate-600">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>

                <div class="flex items-center gap-5 mb-8 border-b border-slate-700/50 pb-6">
                    <div id="modal-icon-wrapper" class="w-16 h-16 md:w-20 md:h-20 rounded-2xl flex items-center justify-center shadow-lg shrink-0 border border-white/10">
                        <i id="modal-icon" class="text-3xl md:text-4xl text-white"></i>
                    </div>
                    <div>
                        <span id="modal-category" class="text-xs md:text-sm font-bold tracking-widest text-blue-400 uppercase mb-1 block"></span>
                        <h2 id="modal-title" class="text-3xl md:text-4xl font-extrabold text-white tracking-tight"></h2>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                    <div class="bg-slate-800/40 p-5 rounded-xl border border-slate-700/50 md:col-span-2">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-2">Definícia / Princíp</h3>
                        <p id="modal-what" class="text-slate-200 leading-relaxed text-sm md:text-base"></p>
                    </div>
                    <div class="bg-slate-800/40 p-5 rounded-xl border border-slate-700/50">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-2">Kedy sa využíva?</h3>
                        <p id="modal-when" class="text-slate-200 leading-relaxed text-sm"></p>
                    </div>
                </div>

                <div id="modal-phases-container" class="mb-8"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                    <div class="bg-emerald-900/10 p-5 rounded-xl border border-emerald-500/20">
                        <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-3 flex items-center"><i class="fa-solid fa-plus-circle mr-2"></i> Výhody</h3>
                        <div id="modal-pros" class="text-slate-300 text-sm leading-relaxed"></div>
                    </div>
                    <div class="bg-red-900/10 p-5 rounded-xl border border-red-500/20">
                        <h3 class="text-sm font-bold text-red-400 uppercase tracking-wider mb-3 flex items-center"><i class="fa-solid fa-minus-circle mr-2"></i> Nevýhody</h3>
                        <div id="modal-cons" class="text-slate-300 text-sm leading-relaxed"></div>
                    </div>
                </div>

                <div class="mt-6 bg-gradient-to-r from-slate-900 to-slate-800 p-6 rounded-xl border border-slate-700">
                    <h3 class="flex items-center text-lg font-bold text-white mb-3">
                        <i class="fa-solid fa-eye text-pink-400 mr-2"></i> Grafický Model
                    </h3>
                    <div class="w-full flex justify-center items-center bg-[#050b14] rounded-xl p-4 md:p-8 border border-slate-700/80 min-h-[250px] overflow-auto relative">
                        <div id="modal-visual-html" class="flex justify-center items-center min-w-max p-4 md:p-8"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        /* TABS PREPÍNANIE */
        function switchTab(tab) {
            const body = document.getElementById('main-body');
            const viewMetodiky = document.getElementById('view-metodiky');
            const viewOtazky = document.getElementById('view-otazky');
            const btnMetodiky = document.getElementById('nav-metodiky');
            const btnOtazky = document.getElementById('nav-otazky');

            if (tab === 'metodiky') {
                body.className = 'antialiased theme-dark';
                viewMetodiky.classList.remove('hidden');
                viewOtazky.classList.add('hidden');
                btnMetodiky.classList.add('active', 'text-white');
                btnOtazky.classList.remove('active', 'text-white');
            } else {
                body.className = 'antialiased theme-light';
                viewMetodiky.classList.add('hidden');
                viewOtazky.classList.remove('hidden');
                btnOtazky.classList.add('active', 'text-white');
                btnMetodiky.classList.remove('active', 'text-white');
            }
        }

        /* --- DÁTA METODÍK (KOMPLETNÉ VŠETKY + structureType) --- */
        const dbMetodiky = [
            {
                id: "waterfall", category: "sdlc", categoryName: "Metodika Vývoja", title: "Waterfall (Vodopádový model)", icon: "fa-water", color: "blue", structureType: "sequence",
                what: "Tradičný, sekvenčný prístup k vývoju softvéru. Práca postupuje výhradne jednosmerne (zhora nadol). Ďalšia fáza môže začať až po úplnom dokončení a formálnom schválení (sign-off) tej predošlej.",
                when: "Projekty s <b>100% jasnými a nemennými požiadavkami</b>. Často sa vyžaduje v regulovaných odvetviach (zdravotníctvo, letectvo, armáda), kde je dôsledná dokumentácia dôležitejšia ako flexibilita.",
                pros: "• Jasná štruktúra a predvídateľný rozpočet.<br>• Dokonalá technická dokumentácia.<br>• Programátor presne vie, čo má robiť.",
                cons: "• Obrovská nepružnosť voči zmenám.<br>• Zákazník vidí produkt až na konci projektu.<br>• Chyby v zadaní zistené v testovaní sú extrémne drahé na opravu.",
                steps: [
                    { title: "Analýza", desc: "Zber požiadaviek a tvorba rozsiahlej špecifikačnej dokumentácie." },
                    { title: "Návrh", desc: "Dizajn softvérovej architektúry a databáz." },
                    { title: "Implementácia", desc: "Samotné programovanie a písanie kódu." },
                    { title: "Testovanie", desc: "Overovanie kódu voči analytickému zadaniu." },
                    { title: "Nasadenie", desc: "Presun do ostrej prevádzky a následná údržba." }
                ],
                visualHtml: `<div class='flex flex-col gap-1 w-full min-w-[280px]'><div class='w-32 bg-blue-600 text-white text-center py-2 rounded shadow-lg text-sm font-bold z-50 border border-blue-400'>Analýza</div><div class='w-32 bg-blue-500 text-white text-center py-2 rounded shadow-lg text-sm font-bold z-40 ml-4 md:ml-8 border border-blue-400'>Návrh</div><div class='w-32 bg-blue-400 text-white text-center py-2 rounded shadow-lg text-sm font-bold z-30 ml-8 md:ml-16 border border-blue-300'>Vývoj</div><div class='w-32 bg-blue-300 text-slate-800 text-center py-2 rounded shadow-lg text-sm font-bold z-20 ml-12 md:ml-24 border border-blue-200'>Testovanie</div><div class='w-32 bg-blue-200 text-slate-800 text-center py-2 rounded shadow-lg text-sm font-bold z-10 ml-16 md:ml-32 border border-blue-200'>Nasadenie</div></div>`
            },
            {
                id: "v-model", category: "sdlc", categoryName: "Metodika Vývoja", title: "V-Model", icon: "fa-v", color: "blue", structureType: "sequence",
                what: "Rozšírenie Waterfall modelu (Verification & Validation). Rieši jeho najväčšiu slabinu – odkladanie testov na koniec. Ku každej fáze návrhu sa tu paralelne vopred plánuje príslušná fáza testovania.",
                when: "Výhradne pre <b>'Safety-critical' projekty</b>, kde softvérová chyba ohrozuje životy alebo veľký majetok (riadenie lietadiel, ABS brzdy, lekárske prístroje).",
                pros: "• Zabezpečuje bezkonkurenčnú kvalitu a spoľahlivosť kódu.<br>• Chyby sa vďaka včasnému plánovaniu testov odhaľujú oveľa skôr.",
                cons: "• Rovnako rigidný voči zmenám ako Waterfall.<br>• Tvorba obrovského množstva testovacích scenárov vopred pýta extrémne veľa času.",
                steps: [
                    { title: "Verifikácia (Naľavo)", desc: "Dekompozícia systému (Analýza, Návrh architektúry, Návrh modulov)." },
                    { title: "Kódovanie (Spodok)", desc: "Programovanie na základe detailného návrhu." },
                    { title: "Validácia (Napravo)", desc: "Postupné testovanie (Jednotkové, Integračné, Systémové, Akceptačné)." }
                ],
                visualHtml: `<div class='flex items-end gap-2 text-xs font-bold text-center w-full max-w-lg justify-center'><div class='flex flex-col gap-4 w-28'><div class='bg-indigo-600 p-2 rounded text-white border border-indigo-400'>Požiadavky</div><div class='bg-indigo-500 p-2 rounded text-white border border-indigo-400'>Architektúra</div><div class='bg-indigo-400 p-2 rounded text-white border border-indigo-300'>Návrh</div></div><div class='flex flex-col items-center gap-2'><i class='fa-solid fa-arrow-down-right text-indigo-500 text-xl'></i><div class='bg-purple-500 p-3 rounded-lg text-white w-24 border border-purple-400 shadow-[0_0_15px_rgba(168,85,247,0.5)]'>Kódovanie</div><i class='fa-solid fa-arrow-up-right text-emerald-500 text-xl'></i></div><div class='flex flex-col gap-4 w-28'><div class='bg-emerald-600 p-2 rounded text-white border border-emerald-400'>Akceptačné T.</div><div class='bg-emerald-500 p-2 rounded text-white border border-emerald-400'>Systémové T.</div><div class='bg-emerald-400 p-2 rounded text-white border border-emerald-300'>Jednotkové T.</div></div></div>`
            },
            {
                id: "iterative", category: "sdlc", categoryName: "Metodika Vývoja", title: "Iteratívny model", icon: "fa-rotate-right", color: "blue", structureType: "sequence",
                what: "Prístup, pri ktorom sa softvér nedodáva naraz (žiadny Big Bang). Aplikácia sa buduje postupne v opakujúcich sa malých cykloch (iteráciách), čím sa postupne nabaľuje novými funkciami.",
                when: "Vhodné pre rozsiahlejšie systémy, kde je hlavný cieľ zrejmý, ale <b>detaily funkcií sa menia</b> na základe spätnej väzby od používateľov.",
                pros: "• Rýchlejšie dodanie základnej (hoci osekanej) verzie aplikácie.<br>• Zákazník si môže produkt ohmatať oveľa skôr.<br>• Ľahšie prispôsobenie zmenám.",
                cons: "• Ak sa na začiatku zle navrhne jadrová architektúra, postupné 'nabaľovanie' funkcií povedie k neudržateľnému špagetovému kódu.",
                steps: [
