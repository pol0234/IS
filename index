            { id: 28, cat: "Vývoj IS a Agilita", icon: "fa-football", color: "#22c55e", 
              q: "Ako funguje Scrum (roly, šprinty, backlog)?", 
              a: "Pracuje v krátkych <span class='hl-blue'>Sprintoch</span> (1-4 týždne).<br><span class='hl-purple'>Product Owner</span> spravuje Product Backlog (zoznam požiadaviek).<br><span class='hl-green'>Scrum Master</span> odstraňuje prekážky.<br>Vývojový tím dodáva hotový prírastok. Úlohy sa berú zo Sprint Backlogu." },
            { id: 29, cat: "Vývoj IS a Agilita", icon: "fa-clipboard-list", color: "#22c55e", 
              q: "Ako funguje Kanban a čo znamená WIP limit?", 
              a: "Kanban vizualizuje prácu na tabuli (To Do &rarr; In Progress &rarr; Done).<br><br><span class='hl-red'>WIP limit (Work In Progress)</span> obmedzuje maximálny počet rozpracovaných úloh v jednom stĺpci, aby sa tím nepretížil a zachoval sa plynulý tok (flow)." },
            { id: 30, cat: "Vývoj IS a Agilita", icon: "fa-hurricane", color: "#22c55e", 
              q: "Čo je špirálový model a kedy sa využíva?", 
              a: "Kombinuje iterácie, prototypovanie a najmä <span class='hl-red'>priebežné vyhodnocovanie rizík</span> v každej slučke špirály.<br><br>Hodí sa pre <span class='hl-purple'>veľké, zložité a vysoko rizikové projekty</span> s nejasnými požiadavkami." },
            { id: 31, cat: "Čas a Plánovanie", icon: "fa-calendar-days", color: "#ef4444", 
              q: "Čo je časový harmonogram projektu a aký je jeho význam?", 
              a: "Určuje činnosti, ich <span class='hl-blue'>poradie, trvanie, termíny, logické náväznosti</span>, zdroje a milníky.<br><br>Slúži k riadeniu času, koordinácii tímu a kontrole, či projekt nemešká." },
            { id: 32, cat: "Čas a Plánovanie", icon: "fa-list-ol", color: "#ef4444", 
              q: "Ako sa vytvára zoznam aktivít projektu?", 
              a: "Vychádza sa z cieľa a <span class='hl-purple'>rozpisu prác (WBS)</span>. Projekt sa hierarchicky rozloží na najmenšie merateľné úlohy.<br>Určia sa ich výstupy, zodpovednosti, <span class='hl-orange'>náväznosti (čo musí byť skôr)</span> a odhady trvania." },
            { id: 33, cat: "Čas a Plánovanie", icon: "fa-chart-gantt", color: "#ef4444", 
              q: "Čo je Ganttov diagram a ako sa interpretuje?", 
              a: "Je to časový plán zobrazený pomocou <span class='hl-blue'>vodorovných pruhov</span> na časovej osi.<br><br>Vizuálne ukazuje, kedy úloha začína/končí, ako dlho trvá, <span class='hl-purple'>ako na seba nadväzujú</span> a kde sú kontrolné body (milníky)." },
            { id: 34, cat: "Čas a Plánovanie", icon: "fa-route", color: "#ef4444", 
              q: "Čo je kritická cesta (CPM) a ako ju určujeme?", 
              a: "Kritická cesta je <span class='hl-red'>najdlhší sled nadväzujúcich činností bez časovej rezervy</span>.<br><br>Určuje najkratšiu možnú dobu trvania celého projektu. Zdržanie akejkoľvek činnosti na nej <span class='hl-red'>zdrží celý projekt</span>." },
            { id: 35, cat: "Čas a Plánovanie", icon: "fa-stopwatch", color: "#ef4444", 
              q: "Čo znamená časová rezerva (float)?", 
              a: "Je to doba, o ktorú je možné konkrétnu činnosť <span class='hl-green'>zdržať</span>, bez toho aby sa zdržala nasledujúca činnosť alebo celkový koniec projektu.<br><br>Činnosti na kritickej ceste majú rezervu <span class='hl-red'>nulovú</span>." },
            { id: 36, cat: "Čas a Plánovanie", icon: "fa-calculator", color: "#ef4444", 
              q: "Ako funguje metóda PERT a aké má vstupy (O, M, P)?", 
              a: "Pracuje s 3 odhadmi trvania činností:<br><span class='hl-green'>O = Optimistický</span><br><span class='hl-blue'>M = Najpravdepodobnejší</span><br><span class='hl-red'>P = Pesimistický</span><br><br>Očakávaný čas = <span class='hl-purple'>(O + 4M + P) / 6</span>." },
            { id: 37, cat: "Čas a Plánovanie", icon: "fa-code-branch", color: "#ef4444", 
              q: "Kedy je vhodné použiť PERT namiesto CPM?", 
              a: "PERT je vhodný, keď sú <span class='hl-red'>doby trvania neisté</span> a je nutné pracovať so štatistickými odhadmi (napr. výskum a vývoj).<br><br>CPM sa používa tam, kde sú časy činností <span class='hl-green'>dobro známe a deterministické</span>." },
            { id: 38, cat: "Čas a Plánovanie", icon: "fa-flag", color: "#ef4444", 
              q: "Čo je milníkové plánovanie a aké má výhody?", 
              a: "Stanovuje kľúčové <span class='hl-green'>kontrolné body (milníky)</span> v čase (napr. schválenie analýzy, spustenie do prevádzky - čas trvania = 0).<br><br>Výhodou je jednoduchá kontrola pre manažment, jasná komunikácia a včasné odhalenie sklzu." },
            { id: 39, cat: "Tím a Roly", icon: "fa-users-gear", color: "#0d9488", 
              q: "Čo je tímový management projektu a prečo je dôležitý?", 
              a: "Znamená <span class='hl-blue'>vedenie, koordináciu, motiváciu a komunikáciu</span> v tíme.<br><br>Je kritický, pretože úspech IS projektov priamo závisí od <span class='hl-green'>spolupráce ľudí</span> (IT, užívatelia, dodávatelia, vedenie)." },
            { id: 40, cat: "Tím a Roly", icon: "fa-user-shield", color: "#0d9488", 
              q: "Aké sú hlavné roly v projektovom tíme IS?", 
              a: "1. <span class='hl-purple'>Vlastník projektu (Sponsor)</span><br>2. Riadiaci výbor (Steering Committee)<br>3. <span class='hl-blue'>Vedúci projektu (PM)</span><br>4. Expertný a vývojový tím<br>5. Zástupcovia <span class='hl-green'>užívateľov (Key users)</span><br>6. Dodávatelia a externí poradcovia." }
        ];

        let qFilter = 'Všetky';
        let flipped = new Set();
        let displayQ = [...dbOtazky];

        function renderOtazkyGrid() {
            const grid = document.getElementById('cards-grid');
            grid.innerHTML = '';
            const filtered = qFilter === 'Všetky' ? displayQ : displayQ.filter(i => i.cat === qFilter);
            
            filtered.forEach(data => {
                const isFlipped = flipped.has(data.id) ? 'flipped' : '';
                grid.innerHTML += `
                <div class="flashcard-container" onclick="handleFlip(${data.id}, this)">
                    <div class="flashcard ${isFlipped}">
                        <div class="flashcard-front" style="border-top-color: ${data.color}">
                            <i class="${data.icon} watermark"></i>
                            <div class="content-z flex flex-col h-full justify-between">
                                <div>
                                    <div class="flex justify-between items-start mb-4">
                                        <span class="text-xs font-bold px-2 py-1 rounded text-white" style="background-color: ${data.color}">${data.cat}</span>
                                        <span class="text-sm font-bold text-gray-400 border border-gray-200 px-2 py-1 rounded-full">#${data.id}</span>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-800 leading-snug">${data.q}</h3>
                                </div>
                                <div class="text-center mt-4 text-sm text-gray-400 font-medium"><i class="fa-solid fa-hand-pointer"></i> Klikni pre odpoveď</div>
                            </div>
                        </div>
                        <div class="flashcard-back">
                            <i class="${data.icon} watermark"></i>
                            <div class="content-z flex flex-col h-full">
                                <div class="text-xs text-gray-400 font-bold mb-3 pb-2 border-b border-gray-100 flex justify-between"><span>Odpoveď</span><span>#${data.id}</span></div>
                                <div class="text-gray-700 leading-relaxed text-[15px] flex-grow">${data.a}</div>
                            </div>
                        </div>
                    </div>
                </div>`;
            });
            updateProgress();
        }

        function handleFlip(id, el) {
            const card = el.querySelector('.flashcard');
            card.classList.toggle('flipped');
            if (card.classList.contains('flipped')) flipped.add(id);
            updateProgress();
        }

        function updateProgress() {
            const t = dbOtazky.length;
            const c = flipped.size;
            const p = Math.round((c/t)*100);
            document.getElementById('progress-bar').style.width = `${p}%`;
            document.getElementById('progress-text').innerText = `${c} / ${t} (${p}%)`;
        }

        function filterCards(cat) {
            qFilter = cat;
            document.querySelectorAll('.btn-filter-q').forEach(b => {
                b.classList.remove('active', 'bg-blue-600', 'text-white');
                if(b.innerText.includes(cat) || (cat==='Všetky' && b.innerText.trim()==='Všetky')) b.classList.add('active');
            });
            renderOtazkyGrid();
        }

        function shuffleCards() {
            for (let i = displayQ.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [displayQ[i], displayQ[j]] = [displayQ[j], displayQ[i]];
            }
            renderOtazkyGrid();
        }

        // INIT
        renderMetodikyCards('all');
        renderOtazkyGrid();

    </script>
</body>
