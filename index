              a: "Klasických 5 skupín je zhodných so životným cyklom: <span class='hl-blue'>Zahájenie</span>, <span class='hl-orange'>Plánovanie</span>, <span class='hl-green'>Vykonávanie</span>, <span class='hl-purple'>Monitorovanie a kontrola</span> a <span class='hl-red'>Ukončenie</span>." },
            { id: 19, cat: "Metodiky a Štandardy", icon: "fa-network-wired", color: "#a855f7", 
